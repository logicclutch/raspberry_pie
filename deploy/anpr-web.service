[Unit]
Description=ANPR web dashboard + API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anpr
Group=anpr
WorkingDirectory=/opt/anpr
Environment=PYTHONUNBUFFERED=1
# glibc: one malloc pool per thread makes a multi-threaded Python grow far past what it uses (HTTP
# threads, two cameras). Two pools keep the RSS close to the real need on the 1 GB Pi.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/anpr/.venv/bin/python -m anpr.web --config /opt/anpr/config.yaml
Restart=always
RestartSec=3
# The engine gets the CPU first; the dashboard is lighter and less urgent.
Nice=5
MemoryMax=200M
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/anpr/data

[Install]
WantedBy=multi-user.target
